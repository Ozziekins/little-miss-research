---
interface Props {
  size?: 'md' | 'lg';
  /** Render as a plain element instead of a home link (e.g. on share cards). */
  asLink?: boolean;
}
const { size = 'md', asLink = true } = Astro.props;
const Tag = asLink ? 'a' : 'div';
---

<Tag class:list={['logo', `logo--${size}`]} {...asLink ? { href: '/', 'aria-label': 'Little Miss Research, home' } : {}}>
  <svg class="logo__glass" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <path
      d="M20 5.5c8.6-.4 15 6.3 14.6 14.3-.3 8-6.9 14.1-14.8 13.8C11.9 33.3 5.6 27 6 19.2 6.3 11.6 12.2 5.9 20 5.5z"
      fill="var(--color-paper-raised)"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"></path>
    <path d="M12.2 16c1.1-3.1 3.6-5.1 6.8-5.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
    ></path>
    <path d="M30.8 30.6l10.9 11.6" fill="none" stroke="currentColor" stroke-width="5.5" stroke-linecap="round"></path>
  </svg>
  <span class="logo__text">
    <span class="logo__name">Little Miss <span class="logo__research">Research</span></span>
    <span class="logo__tagline">papers my IQ can handle</span>
  </span>
</Tag>
