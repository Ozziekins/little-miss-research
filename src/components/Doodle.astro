---
/**
 * Hand-drawn doodles. Ink strokes use currentColor; pastel fills use the
 * --doodle-fill custom property (set per instance via `tint`).
 */
import type { DoodleName } from '@/lib/doodles';

interface Props {
  name: DoodleName;
  tint?: 'yellow' | 'pink' | 'mint' | 'sky' | 'lilac';
  size?: number;
  rotate?: number;
  class?: string;
}
const { name, tint = 'yellow', size = 64, rotate = 0, class: className } = Astro.props;

const s = 'fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"';
const f = 'fill="var(--doodle-fill)" stroke="none"';
const text = (t: string, size = 26) =>
  `<text x="50" y="58" text-anchor="middle" font-family="Gaegu, cursive" font-weight="700" font-size="${size}" fill="currentColor">${t}</text>`;

const art: Record<DoodleName, string> = {
  atom: `<circle cx="50" cy="50" r="6" ${f}/><circle cx="50" cy="50" r="4" fill="currentColor"/>
    <ellipse cx="50" cy="50" rx="38" ry="13" ${s}/><ellipse cx="50" cy="50" rx="38" ry="13" transform="rotate(60 50 50)" ${s}/>
    <ellipse cx="50" cy="50" rx="38" ry="13" transform="rotate(-60 50 50)" ${s}/>`,
  flask: `<path d="M33 68 L44 44 V22 H56 V44 L67 68 Q70 80 60 80 H40 Q30 80 33 68Z" ${f}/>
    <path d="M41 16 H59 M44 17 V44 L28 76 Q25 84 35 84 H65 Q75 84 72 76 L56 44 V17" ${s}/>
    <path d="M34 64 Q50 58 66 64" ${s}/><circle cx="46" cy="72" r="2.5" ${s}/><circle cx="56" cy="68" r="1.8" ${s}/>`,
  benzene: `<path d="M50 14 L81 32 V68 L50 86 L19 68 V32 Z" ${f}/><path d="M50 14 L81 32 V68 L50 86 L19 68 V32 Z" ${s}/>
    <circle cx="50" cy="50" r="18" ${s}/>`,
  formula: `<path d="M14 66 Q50 76 86 64" stroke="var(--doodle-fill)" stroke-width="10" fill="none" stroke-linecap="round"/>${text('E=mc²', 28)}`,
  integral: `<circle cx="50" cy="50" r="30" ${f}/>${text('∫ dx', 30)}`,
  wave: `<path d="M8 50 Q20 22 32 50 T56 50 T80 50 T104 50" stroke="var(--doodle-fill)" stroke-width="9" fill="none" stroke-linecap="round"/>
    <path d="M8 50 Q20 22 32 50 T56 50 T80 50" ${s}/>`,
  pill: `<g transform="rotate(-35 50 50)"><rect x="18" y="36" width="64" height="28" rx="14" ${s}/>
    <path d="M50 36 H68 A14 14 0 0 1 68 64 H50 Z" ${f}/><rect x="18" y="36" width="64" height="28" rx="14" ${s}/><path d="M50 36 V64" ${s}/></g>`,
  pulse: `<path d="M6 54 H30 L38 34 L48 72 L56 44 L62 54 H94" ${s}/><circle cx="48" cy="72" r="5" ${f}/>`,
  plus: `<path d="M40 16 H60 V40 H84 V60 H60 V84 H40 V60 H16 V40 H40 Z" ${f}/><path d="M40 16 H60 V40 H84 V60 H60 V84 H40 V60 H16 V40 H40 Z" ${s}/>`,
  paw: `<ellipse cx="50" cy="62" rx="17" ry="14" ${f}/><ellipse cx="50" cy="62" rx="17" ry="14" ${s}/>
    <ellipse cx="28" cy="40" rx="7" ry="9" ${s}/><ellipse cx="43" cy="28" rx="7" ry="9" ${s}/><ellipse cx="59" cy="28" rx="7" ry="9" ${s}/><ellipse cx="73" cy="40" rx="7" ry="9" ${s}/>`,
  fish: `<path d="M18 50 Q42 24 70 50 Q42 76 18 50Z" ${f}/><path d="M18 50 Q42 24 70 50 Q42 76 18 50Z M70 50 L88 36 V64 Z" ${s}/>
    <circle cx="32" cy="46" r="2.5" fill="currentColor"/><path d="M10 30 q4 -4 8 0 M8 20 q3 -3 6 0" ${s}/>`,
  feather: `<path d="M24 82 Q30 30 78 16 Q72 60 24 82Z" ${f}/><path d="M24 82 Q30 30 78 16 Q72 60 24 82Z M24 82 L64 34" ${s}/>`,
  bubble: `<path d="M22 44 Q22 20 50 20 Q78 20 78 44 Q78 66 52 66 L40 80 L42 66 Q22 64 22 44Z" ${f}/>
    <path d="M22 44 Q22 20 50 20 Q78 20 78 44 Q78 66 52 66 L40 80 L42 66 Q22 64 22 44Z" ${s}/>
    <text x="50" y="52" text-anchor="middle" font-family="Gaegu, cursive" font-weight="700" font-size="26" fill="currentColor">?</text>`,
  bulb: `<circle cx="50" cy="40" r="20" ${f}/><path d="M38 56 Q28 46 30 36 Q34 18 50 18 Q66 18 70 36 Q72 46 62 56 V64 H38 Z M40 72 H60 M43 79 H57" ${s}/>
    <path d="M50 4 V10 M20 14 l5 5 M80 14 l-5 5" ${s}/>`,
  laptop: `<rect x="22" y="24" width="56" height="38" rx="3" ${f}/><rect x="22" y="24" width="56" height="38" rx="3" ${s}/>
    <path d="M12 72 H88 L82 62 H18 Z" ${s}/><path d="M36 40 l-6 5 l6 5 M64 40 l6 5 l-6 5" ${s}/>`,
  code: `<circle cx="50" cy="50" r="30" ${f}/>${text('&lt;/&gt;', 30)}`,
  binary: `<path d="M12 62 Q50 72 88 60" stroke="var(--doodle-fill)" stroke-width="10" fill="none" stroke-linecap="round"/>${text('0110', 28)}`,
  coffee: `<path d="M24 40 H70 V66 Q70 82 54 82 H40 Q24 82 24 66 Z" ${f}/><path d="M24 40 H70 V66 Q70 82 54 82 H40 Q24 82 24 66 Z M70 48 Q84 48 82 60 Q80 70 70 68" ${s}/>
    <path d="M38 30 q-4 -6 0 -12 M50 30 q-4 -6 0 -12 M62 30 q-4 -6 0 -12" ${s}/>`,
  toast: `<path d="M24 84 V44 Q14 40 18 28 Q24 16 50 16 Q76 16 82 28 Q86 40 76 44 V84 Z" ${s}/>
    <rect x="38" y="48" width="24" height="18" rx="3" transform="rotate(-8 50 57)" ${f}/><rect x="38" y="48" width="24" height="18" rx="3" transform="rotate(-8 50 57)" ${s}/>`,
  donut: `<circle cx="50" cy="50" r="32" ${f}/><circle cx="50" cy="50" r="32" ${s}/><circle cx="50" cy="50" r="10" ${s}/>
    <path d="M30 34 l4 3 M64 28 l-2 5 M72 52 l5 1 M36 66 l3 -4 M58 70 l4 2" ${s}/>`,
  star: `<path d="M50 12 L60 38 L88 40 L66 58 L74 86 L50 70 L26 86 L34 58 L12 40 L40 38 Z" ${f}/>
    <path d="M50 12 L60 38 L88 40 L66 58 L74 86 L50 70 L26 86 L34 58 L12 40 L40 38 Z" ${s}/>`,
  wand: `<path d="M20 84 L62 42" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
    <path d="M70 14 L74 28 L88 32 L74 36 L70 50 L66 36 L52 32 L66 28 Z" ${f}/><path d="M70 14 L74 28 L88 32 L74 36 L70 50 L66 36 L52 32 L66 28 Z" ${s}/>`,
  heart: `<path d="M50 82 Q14 56 18 34 Q22 16 38 18 Q48 20 50 32 Q52 20 62 18 Q78 16 82 34 Q86 56 50 82Z" ${f}/>
    <path d="M50 82 Q14 56 18 34 Q22 16 38 18 Q48 20 50 32 Q52 20 62 18 Q78 16 82 34 Q86 56 50 82Z" ${s}/>`,
  sparkle: `<path d="M50 10 Q54 46 90 50 Q54 54 50 90 Q46 54 10 50 Q46 46 50 10Z" ${f}/><path d="M50 10 Q54 46 90 50 Q54 54 50 90 Q46 54 10 50 Q46 46 50 10Z" ${s}/>`,
  arrow: `<path d="M12 70 Q40 20 82 36 M70 26 L84 36 L72 48" ${s}/>`,
  swirl: `<path d="M50 50 m-4 0 a4 4 0 1 1 8 0 a10 10 0 1 1 -20 0 a16 16 0 1 1 32 0 a22 22 0 1 1 -44 0" ${s}/>`,
};
---

<svg
  class:list={['doodle', `doodle--${tint}`, className]}
  viewBox="0 0 100 100"
  width={size}
  height={size}
  style={rotate ? `transform: rotate(${rotate}deg)` : undefined}
  aria-hidden="true"
  focusable="false"
  set:html={art[name]}
/>
