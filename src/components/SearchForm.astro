---
interface Props {
  id?: string;
  value?: string;
  compact?: boolean;
  autofocus?: boolean;
}
const { id = 'search', value = '', compact = false, autofocus = false } = Astro.props;
---

<form action="/search/" method="get" role="search" class:list={['search-form', { 'search-form--compact': compact }]}>
  <label for={id} class="visually-hidden">Search papers</label>
  <input
    id={id}
    class="input search-form__input"
    type="search"
    name="q"
    value={value}
    placeholder={compact ? 'Search…' : 'Try “cats”, “coffee” or “harry potter”'}
    autocomplete="off"
    autofocus={autofocus}
  />
  <button type="submit" class="search-form__button" aria-label="Search">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <circle cx="10" cy="10" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"></circle>
      <path d="M15 15l5.5 5.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path>
    </svg>
  </button>
</form>
