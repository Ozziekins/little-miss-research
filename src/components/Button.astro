---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'ghost';
type Props = (HTMLAttributes<'a'> | HTMLAttributes<'button'>) & {
  href?: string;
  variant?: Variant;
  size?: 'sm' | 'md' | 'lg';
};

const { href, variant = 'primary', size = 'md', class: className, ...rest } = Astro.props;
const classes = ['btn', variant !== 'primary' && `btn--${variant}`, size !== 'md' && `btn--${size}`, className];
---

{
  href ? (
    <a href={href} class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} type="button" {...(rest as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}
